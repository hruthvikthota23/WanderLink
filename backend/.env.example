# WanderLink Backend Environment Variables
# Copy this file to .env and fill in values before running
# Or set these as environment variables / override in application.properties

# MySQL Database
DB_URL=jdbc:mysql://localhost:3306/wanderlink?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=yourpassword

# JWT
# Change this to a random 256-bit (32 char+) secret in production
JWT_SECRET=WanderLinkSuperSecretKeyForJWTTokenGeneration2024!ChangeMe
JWT_EXPIRATION_MS=86400000

# OpenAI Responses API (required for live AI answers)
# Keep the API key private. Set it as a backend environment variable before starting Spring Boot.
WANDERLINK_AI_API_KEY=
WANDERLINK_AI_MODEL=gpt-6-luna
WANDERLINK_AI_API_URL=https://api.openai.com/v1/responses

# Server
SERVER_PORT=8080

# Seed demo data on first run (set to false after first run if desired)
WANDERLINK_SEED_DATA=true
